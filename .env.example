# ---- Storage ----
LAKE_ROOT=./data/lake
SOURCE_DB_PATH=./data/source/reference.db
CONFIG_DIR=./config

# ---- Sources ----
TAXI_BASE_URL=https://d37ci6vzurychx.cloudfront.net/trip-data
ZONES_URL=https://d37ci6vzurychx.cloudfront.net/misc/taxi_zone_lookup.csv
WEATHER_URL=https://archive-api.open-meteo.com/v1/archive
WEATHER_LAT=40.7128
WEATHER_LON=-74.0060
WEATHER_TIMEZONE=America/New_York
HTTP_TIMEOUT_S=60
HTTP_RETRIES=4

# ---- Pipeline policy ----
LATE_ARRIVAL_DAYS=7
FRESHNESS_SLO_HOURS=26

# ---- Spark ----
SPARK_MASTER=local[*]
SPARK_DRIVER_MEMORY=4g
SPARK_SHUFFLE_PARTITIONS=8

# ---- Serving / governance (format: key:role,key:role) ----
API_KEYS=change-me-analyst:analyst,change-me-ml:ml_engineer,change-me-ops:operator
MAX_QUERY_ROWS=10000

# ---- Misc ----
LOG_LEVEL=INFO
